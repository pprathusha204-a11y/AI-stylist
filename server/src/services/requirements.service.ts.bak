function containsKeyword(
  message: string,
  keyword: string,
): boolean {
  const escapedKeyword = keyword
    .replace(
      /[.*+?^${}()|[\]\\]/g,
      "\\$&",
    )
    .replace(/\s+/g, "\\s+");

  return new RegExp(
    `\\b${escapedKeyword}\\b`,
    "i",
  ).test(message);
}

function findKeywordValue(
  message: string,
  values: Record<string, string[]>,
): string | null {
  for (
    const [value, keywords]
    of Object.entries(values)
  ) {
    if (
      keywords.some((keyword) =>
        containsKeyword(
          message,
          keyword,
        ),
      )
    ) {
      return value;
    }
  }

  return null;
}

function convertMoney(
  value: string,
): number {
  const cleanedValue = value
    .replace(/,/g, "")
    .trim()
    .toLowerCase();

  if (cleanedValue.endsWith("k")) {
    return (
      Number(
        cleanedValue.replace(
          "k",
          "",
        ),
      ) * 1000
    );
  }

  return Number(cleanedValue);
}

function hasExplicitMoneyContext(
  message: string,
): boolean {
  return (
    /₹|rs\.?|inr|\bbudget\b/i.test(
      message,
    ) ||
    /\d+(?:\.\d+)?k\b/i.test(
      message,
    )
  );
}

function isBudgetField(
  expectedField:
    | RequirementField
    | null
    | undefined,
): boolean {
  return (
    expectedField === "budgetMin" ||
    expectedField === "budgetMax"
  );
}

function isLikelyMoneyAmount(
  amount: number,
  message: string,
  expectedField:
    | RequirementField
    | null
    | undefined,
): boolean {
  if (!Number.isFinite(amount)) {
    return false;
  }

  if (
    isBudgetField(expectedField) ||
    hasExplicitMoneyContext(message)
  ) {
    return true;
  }

  return amount >= 1000;
}

function extractBudget(
  message: string,
  expectedField:
    | RequirementField
    | null
    | undefined,
): {
  budgetMin?: number;
  budgetMax?: number;
} {
  const rangeMatch = message.match(
    /(?:between\s*)?(?:₹|rs\.?|inr)?\s*([\d,.]+k?)\s*(?:to|and|–|—|-)\s*(?:₹|rs\.?|inr)?\s*([\d,.]+k?)/i,
  );

  if (rangeMatch) {
    const budgetMin =
      convertMoney(rangeMatch[1]);

    const budgetMax =
      convertMoney(rangeMatch[2]);

    if (
      isLikelyMoneyAmount(
        budgetMin,
        message,
        expectedField,
      ) &&
      isLikelyMoneyAmount(
        budgetMax,
        message,
        expectedField,
      )
    ) {
      return {
        budgetMin,
        budgetMax,
      };
    }
  }

  const maximumMatch = message.match(
    /(?:under|below|upto|up to|maximum|max|budget)\s*(?:is|of)?\s*(?:₹|rs\.?|inr)?\s*([\d,.]+k?)/i,
  );

  if (maximumMatch) {
    const budgetMax =
      convertMoney(maximumMatch[1]);

    if (
      isLikelyMoneyAmount(
        budgetMax,
        message,
        expectedField,
      )
    ) {
      return {
        budgetMax,
      };
    }
  }

  const minimumMatch = message.match(
    /(?:above|over|minimum|min|starts from|starting from)\s*(?:₹|rs\.?|inr)?\s*([\d,.]+k?)/i,
  );

  if (minimumMatch) {
    const budgetMin =
      convertMoney(minimumMatch[1]);

    if (
      isLikelyMoneyAmount(
        budgetMin,
        message,
        expectedField,
      )
    ) {
      return {
        budgetMin,
      };
    }
  }

  /*
   * A plain number is treated as money only
   * when the conversation expects a budget.
   */
  if (isBudgetField(expectedField)) {
    const directAmountMatch =
      message.match(
        /(?:₹|rs\.?|inr)?\s*([\d,.]+k?)/i,
      );

    if (directAmountMatch) {
      const amount =
        convertMoney(
          directAmountMatch[1],
        );

      if (Number.isFinite(amount)) {
        return expectedField ===
          "budgetMin"
          ? {
              budgetMin: amount,
            }
          : {
              budgetMax: amount,
            };
      }
    }
  }

  return {};
}

function extractDepartment(
  message: string,
): Pick<
  CustomerRequirements,
  "department" | "gender"
> | null {
  if (
    containsKeyword(
      message,
      "accessories",
    ) ||
    containsKeyword(
      message,
      "shop accessories",
    )
  ) {
    return {
      department: "accessories",
      gender: null,
    };
  }

  if (
    containsKeyword(
      message,
      "shop women",
    ) ||
    containsKeyword(
      message,
      "women",
    ) ||
    containsKeyword(
      message,
      "woman",
    ) ||
    containsKeyword(
      message,
      "female",
    )
  ) {
    return {
      department: "women",
      gender: "women",
    };
  }

  if (
    containsKeyword(
      message,
      "shop men",
    ) ||
    containsKeyword(
      message,
      "men",
    ) ||
    containsKeyword(
      message,
      "man",
    ) ||
    containsKeyword(
      message,
      "male",
    )
  ) {
    return {
      department: "men",
      gender: "men",
    };
  }

  return null;
}

