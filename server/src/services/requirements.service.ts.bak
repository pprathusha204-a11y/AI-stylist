function extractEventDate(
  message: string,
): string | null {
  const values = [
    "this week",
    "next week",
    "this month",
    "next month",
    "not decided",
  ];

  return (
    values.find((value) =>
      containsKeyword(
        message,
        value,
      ),
    ) ?? null
  );
}

function extractVenue(
  message: string,
): string | null {
  if (
    containsKeyword(
      message,
      "destination",
    )
  ) {
    return "destination venue";
  }

  if (
    containsKeyword(
      message,
      "indoor",
    ) ||
    containsKeyword(
      message,
      "indoors",
    )
  ) {
    return "indoor";
  }

  if (
    containsKeyword(
      message,
      "outdoor",
    ) ||
    containsKeyword(
      message,
      "outdoors",
    )
  ) {
    return "outdoor";
  }

  if (
    containsKeyword(
      message,
      "not decided",
    )
  ) {
    return "not decided";
  }

  return null;
}

function extractEventTime(
  message: string,
): string | null {
  if (
    containsKeyword(
      message,
      "evening",
    )
  ) {
    return "evening";
  }

  if (
    containsKeyword(
      message,
      "daytime",
    ) ||
    containsKeyword(
      message,
      "day",
    )
  ) {
    return "day";
  }

  if (
    containsKeyword(
      message,
      "not decided",
    )
  ) {
    return "not decided";
  }

  return null;
}

function extractStyle(
  message: string,
): string | null {
  const styles = [
    "classic",
    "modern",
    "minimal",
    "traditional",
    "luxury",
  ];

  return (
    styles.find((style) =>
      containsKeyword(
        message,
        style,
      ),
    ) ?? null
  );
}

function extractMeasurementMethod(
  message: string,
): string | null {
  const values: Record<
    string,
    string[]
  > = {
    "ready size": [
      "ready size",
    ],

    "custom measurements": [
      "custom measurements",
    ],

    "automated measurements": [
      "automated measurements",
    ],

    "schedule technician": [
      "schedule technician",
      "schedule a technician",
    ],

    "existing garment measurements": [
      "existing garment",
      "existing garment measurements",
    ],
  };

  return findKeywordValue(
    message,
    values,
  );
}

function extractExpectedNumber(
  message: string,
): number | null {
  const match =
    message.match(/\d+/);

  if (!match) {
    return null;
  }

  const value = Number(match[0]);

  return Number.isFinite(value)
    ? value
    : null;
}

export function extractRequirements(
  message: string,
  expectedField?:
    | RequirementField
    | null,
): Partial<CustomerRequirements> {
  const normalizedMessage = message
    .toLowerCase()
    .trim();

  const extracted:
    Partial<CustomerRequirements> = {};

  const department =
    extractDepartment(
      normalizedMessage,
    );

  const category =
    findKeywordValue(
      normalizedMessage,
      categoryKeywords,
    );

  const subcategory =
    findKeywordValue(
      normalizedMessage,
      subcategoryKeywords,
    );

  const occasion =
    findKeywordValue(
      normalizedMessage,
      occasionKeywords,
    );

  const fabric =
    findKeywordValue(
      normalizedMessage,
      fabricKeywords,
    );

  const fit =
    findKeywordValue(
      normalizedMessage,
      fitKeywords,
    );

  const colour =
    findKeywordValue(
      normalizedMessage,
      colourKeywords,
    );

  if (department) {
    extracted.department =
      department.department;

    if (department.gender) {
      extracted.gender =
        department.gender;
    }
  }

  if (category) {
    extracted.category = category;
  }

  if (subcategory) {
    extracted.subcategory =
      subcategory;
  }

  if (occasion) {
    extracted.occasion =
      occasion;
  }

  if (fabric) {
    extracted.fabric = fabric;
  }

  if (fit) {
    extracted.fit = fit;
  }

  if (colour) {
    extracted.colour = colour;
  }

  if (
    expectedField ===
    "weddingFunction"
  ) {
    const weddingFunction =
      extractWeddingFunction(
        normalizedMessage,
      );

    if (weddingFunction) {
      extracted.weddingFunction =
        weddingFunction;

      extracted.occasion =
        "wedding";
    }
  }

  if (
    expectedField ===
    "customerRole"
  ) {
    const customerRole =
      extractCustomerRole(
        normalizedMessage,
      );

    if (customerRole) {
      extracted.customerRole =
        customerRole;
    }
  }

  if (
    expectedField === "eventDate"
  ) {
    const eventDate =
      extractEventDate(
        normalizedMessage,
      );

    if (eventDate) {
      extracted.eventDate =
        eventDate;
    }
  }

  if (
    expectedField === "venue"
  ) {
    const venue =
      extractVenue(
        normalizedMessage,
      );

    if (venue) {
      extracted.venue = venue;
    }
  }

  if (
    expectedField === "eventTime"
  ) {
    const eventTime =
      extractEventTime(
        normalizedMessage,
      );

    if (eventTime) {
      extracted.eventTime =
        eventTime;
    }
  }

  if (
    expectedField ===
    "stylePreference"
  ) {
    const style =
      extractStyle(
        normalizedMessage,
      );

    if (style) {
      extracted.stylePreference =
        style;
    }
  }

  if (
    expectedField ===
    "measurementMethod"
  ) {
    const measurementMethod =
      extractMeasurementMethod(
        normalizedMessage,
      );

    if (measurementMethod) {
      extracted.measurementMethod =
        measurementMethod;
    }
  }

  if (
    expectedField ===
    "heightProfile"
  ) {
    if (
      normalizedMessage.includes(
        "short",
      ) ||
      normalizedMessage.includes(
        "below 168",
      )
    ) {
      extracted.heightProfile =
        "Short";
    } else if (
      normalizedMessage.includes(
        "tall",
      ) ||
      normalizedMessage.includes(
        "above 186",
      )
    ) {
      extracted.heightProfile =
        "Tall";
    } else if (
      normalizedMessage.includes(
        "regular",
      )
    ) {
      extracted.heightProfile =
        "Regular";
    }
  }

  if (
    expectedField === "bodyType"
  ) {
    if (
      normalizedMessage.includes(
        "ectomorph",
      )
    ) {
      extracted.bodyType =
        "Ectomorph";
    } else if (
      normalizedMessage.includes(
        "mesomorph",
      )
    ) {
      extracted.bodyType =
        "Mesomorph";
    } else if (
      normalizedMessage.includes(
        "endomorph",
      )
    ) {
      extracted.bodyType =
        "Endomorph";
    }
  }

  if (
    expectedField === "readySize"
  ) {
    if (
      normalizedMessage.includes(
        "not sure",
      )
    ) {
      extracted.readySize =
        "Not Sure";
    } else {
      const readySizeMatch =
        normalizedMessage.match(
          /\b(2xl|xxl|xl|l|m|s)\b/i,
        );

      if (readySizeMatch) {
        extracted.readySize =
          readySizeMatch[1]
            .toUpperCase()
            .replace("XXL", "2XL");
      }
    }
  }

  if (
    expectedField === "quantity" ||
    expectedField ===
      "employeeCount"
  ) {
    const numericValue =
      extractExpectedNumber(
        normalizedMessage,
      );

    if (numericValue !== null) {
      if (
        expectedField === "quantity"
      ) {
        extracted.quantity =
          numericValue;
      } else {
        extracted.employeeCount =
          numericValue;
      }
    }
  }

    /*
   * Product and fabric card selections.
   */
  const selectedProductMatch =
    message.match(
      /product\s+id\s*(\d+)\s*:\s*(.+)$/i,
    );

  if (selectedProductMatch) {
    extracted.selectedProductId =
      Number(selectedProductMatch[1]);

    extracted.selectedProductName =
      selectedProductMatch[2].trim();
  }

  const selectedFabricMatch =
    message.match(
      /fabric\s+id\s*(\d+)\s*:\s*(.+)$/i,
    );

  if (selectedFabricMatch) {
    extracted.selectedFabricId =
      Number(selectedFabricMatch[1]);

    extracted.fabric =
      selectedFabricMatch[2].trim();
  }

  /*
   * Tailoring customization answers.
   */
  if (
    expectedField ===
    "customizationPreference"
  ) {
    if (
      normalizedMessage.includes(
        "customize",
      ) ||
      normalizedMessage.includes(
        "customise",
      ) ||
      normalizedMessage.includes(
        "personalize",
      ) ||
      normalizedMessage.includes(
        "bespoke",
      )
    ) {
      extracted.customizationPreference =
        "customize style";
    } else if (
      normalizedMessage.includes("keep") ||
      normalizedMessage.includes(
        "recommended design",
      ) ||
      normalizedMessage.includes(
        "standard design",
      )
    ) {
      extracted.customizationPreference =
        "keep recommended design";
    }
  }

    /*
   * Live Tech-Tailor customization
   * option-card selection.
   */


const selectedCustomizationMatch =
  message.match(
    /customization\s+option\s+ids?\s*([\d,\s]+)\s*:\s*(.+)$/i,
  );

const customizationOptionIds =
  selectedCustomizationMatch
    ? selectedCustomizationMatch[1]
        .split(",")
        .map((value) =>
          Number(value.trim()),
        )
        .filter(
          (value) =>
            Number.isInteger(value) &&
            value > 0,
        )
    : [];

const customizationOptionName =
  selectedCustomizationMatch
    ? selectedCustomizationMatch[2].trim()
    : message.trim();

if (
  customizationOptionIds.length > 0
) {
  extracted.selectedCustomizationOptionIds =
    customizationOptionIds;
}

if (customizationOptionName) {
  switch (expectedField) {
    case "lapelStyle":
      extracted.lapelStyle =
        customizationOptionName;
      break;

    case "shoulderStyle":
      extracted.shoulderStyle =
        customizationOptionName;
      break;

    case "buttonStyle":
      extracted.buttonStyle =
        customizationOptionName;
      break;

    case "ventType":
      extracted.ventType =
        customizationOptionName;
      break;

    case "blazerOptions":
      extracted.blazerOptions =
        normalizedMessage.includes(
          "no additional",
        ) ||
        normalizedMessage.includes(
          "none",
        )
          ? "No additional blazer option"
          : customizationOptionName;
      break;

    case "trouserStyle":
      extracted.trouserStyle =
        customizationOptionName;
      break;

    case "trouserWaistbandStyle":
      extracted.trouserWaistbandStyle =
        customizationOptionName;
      break;

    default:
      break;
  }
}

  if (expectedField === "monogramText") {
    if (
      normalizedMessage.includes(
        "no monogram",
      ) ||
      normalizedMessage.includes(
        "do not want",
      )
    ) {
      extracted.monogramText =
        "No monogram";
    } else {
      const monogramText = message
        .replace(
          /^(my initials are|use initials|monogram|initials)\s*[:\-]?\s*/i,
          "",
        )
        .trim();

      if (monogramText) {
        extracted.monogramText =
          monogramText;
      }
    }
  }

  Object.assign(
    extracted,
    extractBudget(
      normalizedMessage,
      expectedField,
    ),
  );

  return extracted;
}